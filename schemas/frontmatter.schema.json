{
  "$defs": {
    "Classification": {
      "enum": [
        "public",
        "internal",
        "confidential"
      ],
      "title": "Classification",
      "type": "string"
    },
    "Confidence": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "Confidence",
      "type": "string"
    },
    "NoteType": {
      "enum": [
        "fleeting",
        "literature",
        "evergreen",
        "moc",
        "adr",
        "experiment",
        "lesson",
        "checklist",
        "idea-ip"
      ],
      "title": "NoteType",
      "type": "string"
    },
    "Origin": {
      "enum": [
        "human",
        "claude",
        "mixed"
      ],
      "title": "Origin",
      "type": "string"
    },
    "Status": {
      "enum": [
        "draft",
        "unverified",
        "verified",
        "deprecated"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "노트 frontmatter. 알 수 없는 추가 필드(예: lesson의 `era`)는 보존한다.",
  "properties": {
    "classification": {
      "$ref": "#/$defs/Classification",
      "default": "internal"
    },
    "confidence": {
      "$ref": "#/$defs/Confidence",
      "default": "medium"
    },
    "created": {
      "format": "date",
      "title": "Created",
      "type": "string"
    },
    "domain": {
      "items": {
        "maxLength": 32,
        "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)*$",
        "type": "string"
      },
      "title": "Domain",
      "type": "array"
    },
    "id": {
      "pattern": "^\\d{8}-\\d{4}-[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Id",
      "type": "string"
    },
    "origin": {
      "$ref": "#/$defs/Origin"
    },
    "projects": {
      "items": {
        "type": "string"
      },
      "title": "Projects",
      "type": "array"
    },
    "reviewed": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reviewed"
    },
    "share": {
      "default": false,
      "title": "Share",
      "type": "boolean"
    },
    "source": {
      "items": {
        "type": "string"
      },
      "title": "Source",
      "type": "array"
    },
    "status": {
      "$ref": "#/$defs/Status"
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "title": "Tags",
      "type": "array"
    },
    "type": {
      "$ref": "#/$defs/NoteType"
    }
  },
  "required": [
    "id",
    "type",
    "status",
    "origin",
    "created"
  ],
  "title": "Frontmatter",
  "type": "object"
}
