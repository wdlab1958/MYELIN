{
  "$defs": {
    "Term": {
      "additionalProperties": false,
      "properties": {
        "aliases": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Aliases",
          "type": "array"
        },
        "definition": {
          "default": "",
          "title": "Definition",
          "type": "string"
        },
        "domain": {
          "anyOf": [
            {
              "maxLength": 32,
              "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Domain"
        },
        "term": {
          "minLength": 1,
          "title": "Term",
          "type": "string"
        }
      },
      "required": [
        "term"
      ],
      "title": "Term",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "terms": {
      "items": {
        "$ref": "#/$defs/Term"
      },
      "minItems": 1,
      "title": "Terms",
      "type": "array"
    }
  },
  "required": [
    "terms"
  ],
  "title": "TaxonomyFile",
  "type": "object"
}
