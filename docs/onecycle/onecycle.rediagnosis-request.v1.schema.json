{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "onecycle.rediagnosis-request/v1",
  "title": "One Cycle re-diagnosis request (ARGUS -> LLMOps / SSC / Proof-Skills)",
  "type": "object",
  "required": ["schema", "source", "request_id", "generated_at", "trigger", "requested_stages", "rationale"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "onecycle.rediagnosis-request/v1"},
    "source": {
      "type": "object", "required": ["platform"], "additionalProperties": false,
      "properties": {"platform": {"const": "argus"}, "version": {"type": "string"}}
    },
    "request_id": {"type": "string", "minLength": 1, "description": "stable per campaign/alert group; importers use it for idempotency"},
    "tenant": {"type": "string"},
    "generated_at": {"type": "string", "format": "date-time"},
    "trigger": {
      "type": "object", "required": ["alert_ids", "severity", "summary"], "additionalProperties": false,
      "properties": {
        "alert_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "severity": {"enum": ["critical", "high", "medium", "low"]},
        "mitre": {"type": "array", "items": {"type": "string"}},
        "summary": {"type": "string", "minLength": 1}
      }
    },
    "affected": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "assets": {"type": "array", "items": {"type": "string"}},
        "services": {"type": "array", "items": {"type": "string"}}
      }
    },
    "requested_stages": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["llmops", "ssc", "proof-skills"]}},
    "rationale": {"type": "string", "minLength": 1}
  }
}
