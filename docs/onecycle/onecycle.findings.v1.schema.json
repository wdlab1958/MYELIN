{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "onecycle.findings/v1",
  "title": "One Cycle common finding exchange file",
  "type": "object",
  "required": ["schema", "source", "subject", "findings"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "onecycle.findings/v1"},
    "source": {
      "type": "object",
      "required": ["platform", "generated_at"],
      "additionalProperties": false,
      "properties": {
        "platform": {"enum": ["llmops", "ssc", "proof-skills", "argus"]},
        "version": {"type": "string"},
        "run_id": {"type": "string"},
        "generated_at": {"type": "string", "format": "date-time"}
      }
    },
    "subject": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "repo": {"type": "string"},
        "commit": {"type": "string"},
        "environment": {"type": "string"}
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "category", "severity", "status", "evidence", "simulated"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^(llmops|ssc|proof-skills|argus):.+"},
          "title": {"type": "string", "minLength": 1},
          "description": {"type": "string"},
          "category": {"enum": ["quality", "security", "formal", "operations"]},
          "severity": {"enum": ["critical", "high", "medium", "low", "info"]},
          "status": {"enum": ["open", "confirmed", "fixed", "accepted", "false_positive"]},
          "simulated": {"type": "boolean", "description": "true when the result was NOT measured on the real target (demo/simulated mode)"},
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["kind", "ref"],
              "additionalProperties": false,
              "properties": {
                "kind": {"enum": ["trace", "test", "tlc_log", "proof", "alert", "scan", "doc", "commit"]},
                "ref": {"type": "string", "minLength": 1},
                "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              }
            }
          },
          "location": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "file": {"type": "string"},
              "line": {"type": "integer", "minimum": 1},
              "component": {"type": "string"}
            }
          },
          "recommendation": {"type": "string"},
          "links": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "mitre": {"type": "array", "items": {"type": "string"}},
              "iso27001": {"type": "array", "items": {"type": "string"}},
              "upstream": {"type": "array", "items": {"type": "string"}, "description": "ids of findings from another platform this one was derived from"}
            }
          }
        }
      }
    }
  }
}
