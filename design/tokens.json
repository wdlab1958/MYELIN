{
  "$schema": "./tokens.schema.json",
  "name": "MYELIN Emboss",
  "version": "1.0.0",
  "source": "docs/spec/MYELIN_Rev2.0.md §8.1, §8.2, §8.3, §8.4 · ADR-0008 (contrast adjustments)",
  "note": "Single source of truth. design/dist/emboss.css, design/dist/tailwind.preset.cjs and theme/obsidian-myelin-emboss/theme.css are GENERATED by scripts/emboss.py — never hand-edit them. Dark mode is out of scope for v1.0; `modes` is reserved.",
  "modes": { "light": "default" },
  "color": {
    "surface":      { "value": "#EEF0F6", "role": "전체 배경 = 카드 색 (뉴모피즘은 순백 배경에서 성립하지 않음)" },
    "surface-2":    { "value": "#E6E9F2", "role": "표면 위 구획(테이블 헤더·코드 배경). 그림자 외 1단계 구분" },
    "shadow-light": { "value": "#FFFFFF", "role": "좌상단 하이라이트" },
    "shadow-dark":  { "value": "rgba(163,177,198,0.62)", "hex": "#AEB8CC", "role": "우하단 그림자" },
    "ink":          { "value": "#2D2A3E", "role": "본문 텍스트. 네온 위 텍스트는 항상 ink" },
    "muted":        { "value": "#5F6378", "spec": "#6B6F85", "role": "보조 텍스트 (spec 값은 surface 위 4.35:1 → ADR-0008 로 어둡게 조정)" },
    "border":       { "value": "#DADEE9", "role": "입력창·버튼 1px 경계선 (접근성 가드레일 3)" },
    "violet-600":   { "value": "#7C3AED", "role": "Primary — 주 버튼, 선택 상태, 링크, 브랜드" },
    "violet-50":    { "value": "#F3F0FF", "role": "Violet 계열 칩 배경" },
    "neon-lime":    { "value": "#B6FF3B", "role": "verified / myelinated — 채움·glow·링 전용" },
    "lime-ink":     { "value": "#3F6A0A", "spec": "#4D7C0F", "role": "Lime 의 어두운 변형 — 텍스트/숫자 강조 (spec 값 4.38:1 → 조정)" },
    "neon-cyan":    { "value": "#22E4FF", "role": "origin: claude — AI 생성물 식별" },
    "cyan-ink":     { "value": "#0E7490", "spec": "#0891B2", "role": "Cyan 의 어두운 변형 — 텍스트/숫자 강조 (spec 값 3.23:1 → 조정)" },
    "neon-magenta": { "value": "#FF3DCB", "role": "fail-closed 차단 / 경고 — 외곽선·배지 전용" },
    "magenta-ink":  { "value": "#BE188C", "role": "blocked 배지 텍스트" },
    "magenta-50":   { "value": "#FFEBF9", "role": "blocked 배지 배경" },
    "on-violet":    { "value": "#FFFFFF", "role": "Primary 버튼 위 텍스트" }
  },
  "shadow": {
    "raised":      { "value": "12px 12px 24px {color.shadow-dark}, -12px -12px 24px {color.shadow-light}", "role": "카드·버튼 (돌출)" },
    "raised-sm":   { "value": "6px 6px 12px {color.shadow-dark}, -6px -6px 12px {color.shadow-light}", "role": "작은 컨트롤·Orb" },
    "inset":       { "value": "inset 6px 6px 12px {color.shadow-dark}, inset -6px -6px 12px {color.shadow-light}", "role": "입력창·활성 메뉴·눌린 토글 (함몰)" },
    "glow-violet": { "value": "0 8px 24px rgba(124,58,237,0.45)", "role": "Primary 버튼 glow" },
    "glow-ai":     { "value": "0 0 32px rgba(34,228,255,0.35)", "role": "ai-draft 카드 glow" },
    "ring-lime":   { "value": "0 0 0 3px {color.neon-lime}", "role": "verified ring (myelinated)" }
  },
  "radius": {
    "card":    { "value": "28px" },
    "control": { "value": "20px" },
    "chip":    { "value": "999px" }
  },
  "space": {
    "1": { "value": "4px" }, "2": { "value": "8px" }, "3": { "value": "12px" }, "4": { "value": "16px" },
    "5": { "value": "24px" }, "6": { "value": "32px" }, "7": { "value": "48px" }
  },
  "font": {
    "sans": { "value": "'Pretendard Variable', Pretendard, 'Inter', system-ui, -apple-system, 'Segoe UI', 'Apple SD Gothic Neo', 'Noto Sans KR', sans-serif" },
    "mono": { "value": "'JetBrains Mono', 'SFMono-Regular', Consolas, 'Liberation Mono', monospace" },
    "size-xs": { "value": "12px" }, "size-sm": { "value": "14px" }, "size-md": { "value": "16px" },
    "size-lg": { "value": "20px" }, "size-xl": { "value": "28px" }, "size-kpi": { "value": "40px" }
  },
  "focus": {
    "ring": { "value": "2px solid {color.violet-600}", "offset": "2px", "role": "Focus 는 그림자만으로 표현 금지" }
  },
  "motion": {
    "myelinate": { "value": "myelinate 600ms ease-out", "role": "verified 승격 순간 링이 감기는 애니메이션" }
  },
  "semantic": {
    "status.draft":    { "chip": "outline {color.violet-600}", "text": "{color.violet-600}", "label": "draft" },
    "status.ai-draft": { "chip": "fill {color.neon-cyan}", "text": "{color.ink}", "glow": "{shadow.glow-ai}", "label": "ai-draft" },
    "status.verified": { "chip": "fill {color.neon-lime}", "text": "{color.ink}", "ring": "{shadow.ring-lime}", "label": "verified", "animation": "{motion.myelinate}" },
    "status.blocked":  { "badge": "outline {color.neon-magenta}", "text": "{color.magenta-ink}", "bg": "{color.magenta-50}", "label": "blocked" },
    "domain.accent":   { "source": "pack.domains[].accent", "role": "Domain Orb 테두리 glow", "values": ["violet", "lime", "cyan", "magenta"] }
  },
  "a11y": {
    "min-text-contrast": 4.5,
    "neon-as-text": false,
    "state-needs-text-label": true,
    "text-pairs": [
      { "fg": "color.ink", "bg": "color.surface", "use": "본문" },
      { "fg": "color.muted", "bg": "color.surface", "use": "보조 텍스트·라벨" },
      { "fg": "color.ink", "bg": "color.surface-2", "use": "테이블 헤더" },
      { "fg": "color.muted", "bg": "color.surface-2", "use": "테이블 헤더 보조" },
      { "fg": "color.violet-600", "bg": "color.surface", "use": "링크·활성 Nav" },
      { "fg": "color.violet-600", "bg": "color.violet-50", "use": "draft 칩 텍스트" },
      { "fg": "color.on-violet", "bg": "color.violet-600", "use": "Primary 버튼" },
      { "fg": "color.ink", "bg": "color.neon-lime", "use": "verified 칩" },
      { "fg": "color.ink", "bg": "color.neon-cyan", "use": "ai-draft 칩" },
      { "fg": "color.lime-ink", "bg": "color.surface", "use": "KPI 숫자 (verified 계열)" },
      { "fg": "color.cyan-ink", "bg": "color.surface", "use": "KPI 숫자 (AI 계열)" },
      { "fg": "color.magenta-ink", "bg": "color.magenta-50", "use": "blocked 배지" },
      { "fg": "color.magenta-ink", "bg": "color.surface", "use": "차단 카운트" }
    ]
  }
}
