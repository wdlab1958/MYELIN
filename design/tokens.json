{
  "$description": "MYELIN Emboss — 디자인 토큰 단일 원천 (명세 §8, ADR-0007). 값을 바꾼 뒤 `python design/build.py` 로 산출물을 다시 만든다. '{group.name}' 은 참조.",
  "color": {
    "surface": "#EEF0F6",
    "surface-well": "#E7EAF2",
    "white": "#FFFFFF",
    "ink": "#2D2A3E",
    "muted": "#5D6178",
    "line": "#D9DDE8",
    "shadow-light": "#FFFFFF",
    "shadow-dark": "rgba(163, 177, 198, 0.62)",
    "violet": "#7C3AED",
    "violet-ink": "#6D28D9",
    "violet-50": "#F3F0FF",
    "lime": "#B6FF3B",
    "lime-ink": "#3F6212",
    "lime-50": "#F2FCE0",
    "cyan": "#22E4FF",
    "cyan-ink": "#0E7490",
    "cyan-50": "#E0FBFF",
    "magenta": "#FF3DCB",
    "magenta-ink": "#BE188C",
    "magenta-50": "#FFEBF9",
    "amber": "#FFB020",
    "amber-ink": "#92400E",
    "amber-50": "#FFF4DB",
    "slate": "#94A3B8",
    "slate-ink": "#334155",
    "slate-50": "#EEF2F7"
  },
  "glow": {
    "violet": "rgba(124, 58, 237, 0.45)",
    "lime": "rgba(182, 255, 59, 0.45)",
    "cyan": "rgba(34, 228, 255, 0.40)",
    "magenta": "rgba(255, 61, 203, 0.35)",
    "amber": "rgba(255, 176, 32, 0.40)",
    "slate": "rgba(148, 163, 184, 0.40)"
  },
  "accent": {
    "violet": { "fill": "{color.violet}", "ink": "{color.violet-ink}", "soft": "{color.violet-50}", "glow": "{glow.violet}" },
    "cyan": { "fill": "{color.cyan}", "ink": "{color.cyan-ink}", "soft": "{color.cyan-50}", "glow": "{glow.cyan}" },
    "lime": { "fill": "{color.lime}", "ink": "{color.lime-ink}", "soft": "{color.lime-50}", "glow": "{glow.lime}" },
    "magenta": { "fill": "{color.magenta}", "ink": "{color.magenta-ink}", "soft": "{color.magenta-50}", "glow": "{glow.magenta}" },
    "amber": { "fill": "{color.amber}", "ink": "{color.amber-ink}", "soft": "{color.amber-50}", "glow": "{glow.amber}" },
    "slate": { "fill": "{color.slate}", "ink": "{color.slate-ink}", "soft": "{color.slate-50}", "glow": "{glow.slate}" }
  },
  "status": {
    "verified": { "bg": "{color.lime}", "fg": "{color.ink}", "line": "{color.lime}" },
    "ai": { "bg": "{color.cyan}", "fg": "{color.ink}", "line": "{color.cyan}" },
    "draft": { "bg": "{color.violet-50}", "fg": "{color.violet-ink}", "line": "{color.violet}" },
    "blocked": { "bg": "{color.magenta-50}", "fg": "{color.magenta-ink}", "line": "{color.magenta}" }
  },
  "shadow": {
    "raised": "12px 12px 24px {color.shadow-dark}, -12px -12px 24px {color.shadow-light}",
    "raised-sm": "6px 6px 12px {color.shadow-dark}, -6px -6px 12px {color.shadow-light}",
    "inset": "inset 6px 6px 12px {color.shadow-dark}, inset -6px -6px 12px {color.shadow-light}",
    "inset-sm": "inset 3px 3px 6px {color.shadow-dark}, inset -3px -3px 6px {color.shadow-light}",
    "primary": "0 8px 24px {glow.violet}"
  },
  "radius": { "card": "28px", "control": "20px", "chip": "999px", "sm": "12px" },
  "space": { "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "24px", "6": "32px", "7": "48px" },
  "font": {
    "sans": "\"Pretendard\", \"Noto Sans KR\", \"Apple SD Gothic Neo\", \"Malgun Gothic\", system-ui, sans-serif",
    "mono": "\"JetBrains Mono\", \"D2Coding\", ui-monospace, monospace",
    "size-xs": "12px",
    "size-sm": "14px",
    "size-md": "16px",
    "size-lg": "20px",
    "size-xl": "28px",
    "size-kpi": "44px"
  },
  "focus": { "ring": "2px solid {color.violet}", "offset": "2px" },
  "motion": { "fast": "120ms", "base": "200ms", "ease": "cubic-bezier(0.2, 0.8, 0.2, 1)" },
  "contrast": {
    "$description": "텍스트로 쓰이는 조합. 모두 WCAG AA 4.5:1 이상이어야 한다.",
    "pairs": [
      ["color.ink", "color.surface"],
      ["color.muted", "color.surface"],
      ["color.ink", "color.white"],
      ["color.white", "color.violet"],
      ["color.violet-ink", "color.surface"],
      ["color.violet-ink", "color.violet-50"],
      ["color.ink", "color.lime"],
      ["color.lime-ink", "color.surface"],
      ["color.ink", "color.cyan"],
      ["color.cyan-ink", "color.surface"],
      ["color.magenta-ink", "color.magenta-50"],
      ["color.magenta-ink", "color.surface"],
      ["color.ink", "color.amber"],
      ["color.amber-ink", "color.surface"],
      ["color.ink", "color.slate"],
      ["color.slate-ink", "color.surface"],
      ["color.ink", "color.surface-well"],
      ["color.muted", "color.surface-well"]
    ],
    "neon": ["color.lime", "color.cyan", "color.magenta", "color.amber", "color.slate"]
  }
}
