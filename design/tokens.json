{
  "$schema": "./tokens.schema.json",
  "name": "MYELIN Emboss",
  "version": "0.1.0",
  "source": "docs/spec/MYELIN_Rev2.0.md §8.1, §8.4",
  "note": "Single source of truth. CSS vars / Tailwind preset / Obsidian theme are GENERATED from this file (P5). Dark mode is out of scope for v1.0; the `modes` structure is reserved.",
  "modes": { "light": "default" },
  "color": {
    "surface":    { "value": "#EEF0F6", "role": "전체 배경 = 카드 색 (뉴모피즘은 순백 배경에서 성립하지 않음)" },
    "shadow-light": { "value": "#FFFFFF", "role": "좌상단 하이라이트" },
    "shadow-dark":  { "value": "rgba(163,177,198,.62)", "hex": "#AEB8CC", "role": "우하단 그림자" },
    "ink":        { "value": "#2D2A3E", "role": "본문 텍스트. 네온 위 텍스트는 항상 ink" },
    "muted":      { "value": "#6B6F85", "role": "보조 텍스트" },
    "border":     { "value": "#E2E5EE", "role": "입력창 1px 경계선 (접근성 가드레일 3)" },
    "violet-600": { "value": "#7C3AED", "role": "Primary — 주 버튼, 선택 상태, 링크, 브랜드" },
    "violet-50":  { "value": "#F3F0FF", "role": "Violet 계열 칩 배경" },
    "neon-lime":  { "value": "#B6FF3B", "role": "verified / myelinated — 채움·glow·링 전용" },
    "lime-ink":   { "value": "#4D7C0F", "role": "Lime의 어두운 변형 — 텍스트/숫자 강조용" },
    "neon-cyan":  { "value": "#22E4FF", "role": "origin: claude — AI 생성물 식별" },
    "cyan-ink":   { "value": "#0891B2", "role": "Cyan의 어두운 변형 — 텍스트/숫자 강조용" },
    "neon-magenta": { "value": "#FF3DCB", "role": "fail-closed 차단 / 경고" },
    "magenta-ink":  { "value": "#BE188C", "role": "blocked 배지 텍스트" },
    "magenta-50":   { "value": "#FFEBF9", "role": "blocked 배지 배경" }
  },
  "shadow": {
    "raised": { "value": "12px 12px 24px {color.shadow-dark}, -12px -12px 24px {color.shadow-light}", "role": "카드·버튼 (돌출)" },
    "inset":  { "value": "inset 6px 6px 12px {color.shadow-dark}, inset -6px -6px 12px {color.shadow-light}", "role": "입력창·활성 메뉴·눌린 토글 (함몰)" },
    "glow-violet": { "value": "0 8px 24px rgba(124,58,237,.45)", "role": "Primary 버튼 glow" },
    "glow-ai":     { "value": "0 0 32px rgba(34,228,255,.35)", "role": "ai-draft 카드 glow" }
  },
  "radius": {
    "card":    { "value": "28px" },
    "control": { "value": "20px" },
    "chip":    { "value": "999px" }
  },
  "focus": {
    "ring": { "value": "2px solid {color.violet-600}", "offset": "2px", "role": "Focus는 그림자만으로 표현 금지" }
  },
  "semantic": {
    "status.draft":    { "chip": "outline {color.violet-600}", "label": "draft" },
    "status.ai-draft": { "chip": "fill {color.neon-cyan}", "glow": "{shadow.glow-ai}", "label": "ai-draft" },
    "status.verified": { "chip": "fill {color.neon-lime}", "ring": "{color.neon-lime}", "label": "verified", "animation": "myelinated-ring" },
    "status.blocked":  { "badge": "outline {color.neon-magenta}", "text": "{color.magenta-ink}", "bg": "{color.magenta-50}", "label": "blocked" },
    "domain.accent":   { "source": "pack.domains[].accent", "role": "Domain Orb 테두리 glow" }
  },
  "a11y": {
    "min-text-contrast": 4.5,
    "neon-as-text": false,
    "state-needs-text-label": true
  }
}
